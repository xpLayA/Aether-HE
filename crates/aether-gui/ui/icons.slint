// Line icons on a 24x24 grid, drawn as paths (no icon font needed).

export component Icon inherits Rectangle {
    in property <string> name;
    in property <color> tint: #e7eaef;
    in property <length> size: 18px;
    width: size;
    height: size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.8px;
        commands: root.name == "profiles" ? "M12 3 L21 8 L12 13 L3 8 Z M3 12.5 L12 17.5 L21 12.5 M3 17 L12 22 L21 17"
            : root.name == "lighting" ? "M12 8 A4 4 0 1 1 11.99 8 Z M12 2 L12 4 M12 20 L12 22 M2 12 L4 12 M20 12 L22 12 M4.9 4.9 L6.3 6.3 M17.7 17.7 L19.1 19.1 M4.9 19.1 L6.3 17.7 M17.7 6.3 L19.1 4.9"
            : root.name == "effects" ? "M11 3 L12.8 9.2 L19 11 L12.8 12.8 L11 19 L9.2 12.8 L3 11 L9.2 9.2 Z M19 2 L19 6 M17 4 L21 4"
            : root.name == "actuation" ? "M4 6 L20 6 M4 12 L20 12 M4 18 L20 18 M9 3.5 L9 8.5 M15 9.5 L15 14.5 M7 15.5 L7 20.5"
            : root.name == "keys" ? "M4 7 L20 7 L20 17 L4 17 Z M8 11 L8 13 M12 11 L12 13 M16 11 L16 13 M9 7 L9 4 L15 4 L15 7"
            : root.name == "live" ? "M3 12 L7 12 L10 5 L14 19 L17 12 L21 12"
            : root.name == "backups" ? "M3.5 12 A8.5 8.5 0 1 0 6 6 M3 3.5 L3 8.5 L8 8.5 M12 7.5 L12 12 L15 14"
            : root.name == "device" ? "M3 6 L21 6 L21 18 L3 18 Z M7 10 L7.01 10 M11 10 L11.01 10 M15 10 L15.01 10 M7 14 L17 14"
            : root.name == "shortcuts" ? "M3 5 L10 5 L10 12 L3 12 Z M14 12 L21 12 L21 19 L14 19 Z M5.5 8.5 L7.5 8.5 M10 8.5 L17.5 8.5 L17.5 12 M15.5 10 L17.5 12 L19.5 10"
            : root.name == "logo" ? "M12 2 L21 7 L21 17 L12 22 L3 17 L3 7 Z M12 7 L16.5 9.5 L16.5 14.5 L12 17 L7.5 14.5 L7.5 9.5 Z"
            : root.name == "refresh" ? "M20 12 A8 8 0 1 1 17.7 6.3 M20 4 L20 9 L15 9"
            : "M12 12 L12.01 12";
    }
}
