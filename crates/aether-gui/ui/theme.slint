// Design tokens: one dark palette, Fluent's sky-blue accent, an 8 px grid.

export global Theme {
    out property <color> bg: #0d1015;
    out property <color> sidebar: #11151b;
    out property <color> surface: #161b22;
    out property <color> surface-2: #1c222b;
    out property <color> surface-3: #252c37;
    out property <color> hover: #2c3440;
    out property <color> border: #262d38;
    out property <color> border-strong: #343d4a;
    out property <color> text: #e7eaef;
    out property <color> muted: #8d97a5;
    out property <color> faint: #5d6774;
    out property <color> accent: #60cdff;
    out property <color> accent-hover: #7dd7ff;
    out property <color> accent-soft: #60cdff26;
    out property <color> on-accent: #03121b;
    out property <color> ok: #4ade80;
    out property <color> warn: #fbbf24;
    out property <color> danger: #f87171;
    out property <color> danger-soft: #f8717122;
    out property <color> key-face: #262d38;
    out property <color> key-edge: #1a1f27;
    out property <color> key-shadow: #06080b;

    out property <length> radius: 8px;
    out property <length> radius-lg: 14px;
    out property <length> font: 14px;
    out property <length> font-small: 12px;
    out property <length> font-title: 22px;
}
